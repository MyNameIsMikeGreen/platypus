{% load static %}{
  "name": "Platypus",
  "short_name": "Platypus",
  "description": "A personal collection of dependable recipes.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "background_color": "#f7f4eb",
  "theme_color": "#f7f4eb",
  "icons": [
    {
      "src": "{% static 'recipes/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'recipes/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'recipes/icon-512-maskable.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
